configfile: "config.yaml"

rule all:
    input:
        "results/Step7/cleanup_done.txt"

rule step1a_isscoverage:
    output:
        "results/Step1a/done.txt"
    params:
        logs_dir=config["step1a"]["logs_dir"],  # <-- New field in config.yaml
        output_dir=config["step1a"]["output_dir"]
    shell:
        """
        python Step1a_IssCov.py \
            --logs_dir {params.logs_dir} \
            --output_dir {params.output_dir} \
            --marker_file {output}
        """
# Step 2: Populate ISS
